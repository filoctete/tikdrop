# Copy this file to .env and fill in your own values. .env is gitignored - never commit real keys.

# Free key at https://console.groq.com/keys - used for AI-assisted suggestions (optional).
GROQ_API_KEY=

# Free "script" app at https://www.reddit.com/prefs/apps - used for the Reddit trend connector
# (optional; requires Reddit's separate API-access approval, so may not be usable yet).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Only needed for a real deployment (apps/api) - local dev defaults to a SQLite file
# (tikdrop.db) with no setup. A free Postgres instance (e.g. Neon or Supabase) works here.
DATABASE_URL=

# Only needed for a real deployment - comma-separated origins allowed to call the API
# (e.g. https://your-app.vercel.app). Defaults to http://localhost:3000 for local dev.
ALLOWED_ORIGINS=
